{
  "name": "my-movies",
  "version": "0.3.0",
  "description": "Local cinematic media library and player built with Electron.",
  "main": "electron/main.js",
  "author": "yetsin7",
  "license": "MIT",
  "homepage": "https://github.com/yetsin7/my-movies#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yetsin7/my-movies.git"
  },
  "bugs": {
    "url": "https://github.com/yetsin7/my-movies/issues"
  },
  "keywords": [
    "electron",
    "media-library",
    "video-player",
    "movies",
    "local-first"
  ],
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "icons": "electron scripts/generate-icons.js",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/library.js && node --check electron/media-probe.js && node --check electron/audio-stream.js && node --check scripts/generate-icons.js && node --check src/renderer.js"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.mymovies.desktop",
    "productName": "My Movies",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Movies",
      "uninstallDisplayName": "My Movies",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "language": "3082",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "Video MP4",
        "description": "Video (MP4)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "mkv",
        "name": "Video MKV",
        "description": "Video (MKV)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "mov",
        "name": "Video MOV",
        "description": "Video (MOV)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "m4v",
        "name": "Video M4V",
        "description": "Video (M4V)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "avi",
        "name": "Video AVI",
        "description": "Video (AVI)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "webm",
        "name": "Video WEBM",
        "description": "Video (WEBM)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "wmv",
        "name": "Video WMV",
        "description": "Video (WMV)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "flv",
        "name": "Video FLV",
        "description": "Video (FLV)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "mpeg",
        "name": "Video MPEG",
        "description": "Video (MPEG)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "mpg",
        "name": "Video MPG",
        "description": "Video (MPG)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "ts",
        "name": "Video TS",
        "description": "Video (TS)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "m2ts",
        "name": "Video M2TS",
        "description": "Video (M2TS)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "mts",
        "name": "Video MTS",
        "description": "Video (MTS)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": "ogv",
        "name": "Video OGV",
        "description": "Video (OGV)",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ]
  },
  "packageManager": "pnpm@11.2.2"
}
